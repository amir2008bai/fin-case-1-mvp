{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fx_row.schema.json",
  "title": "fx_row",
  "type": "object",
  "properties": {
    "fx_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "target_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "rate": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    }
  },
  "required": [
    "fx_id",
    "date",
    "source_currency",
    "target_currency",
    "rate"
  ],
  "additionalProperties": false
}
